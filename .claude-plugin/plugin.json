{
  "name": "openalex-mcp-server",
  "version": "0.7.7",
  "description": "Access the OpenAlex academic research catalog - 270M+ publications through MCP. STDIO & Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/openalex-mcp-server#readme",
  "repository": "https://github.com/cyanheads/openalex-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "openalex-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/openalex-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "OPENALEX_API_KEY": ""
      }
    }
  }
}
