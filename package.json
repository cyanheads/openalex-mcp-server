{
  "name": "@cyanheads/openalex-mcp-server",
  "version": "0.7.4",
  "description": "Access the OpenAlex academic research catalog - 270M+ publications through MCP. STDIO & Streamable HTTP.",
  "mcpName": "io.github.cyanheads/openalex-mcp-server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "openalex-mcp-server": "dist/index.js"
  },
  "files": ["dist/", "README.md", "LICENSE", "CLAUDE.md", "AGENTS.md", "Dockerfile", "server.json"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "rebuild": "bun scripts/clean.ts && bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "devcheck": "bun scripts/devcheck.ts",
    "tree": "bun scripts/tree.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun scripts/lint-mcp.ts",
    "lint:packaging": "bun scripts/lint-packaging.ts",
    "list-skills": "bun scripts/list-skills.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/openalex-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/openalex-mcp-server.mcpb",
    "generate:field-catalog": "bun scripts/generate-field-catalog.ts",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "changelog:build": "bun scripts/build-changelog.ts",
    "changelog:check": "bun scripts/build-changelog.ts --check",
    "test": "vitest run",
    "release:github": "bun scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "openalex",
    "academic-research",
    "academic-search",
    "bibliometrics",
    "bun",
    "citation-analysis",
    "literature-search",
    "scholarly-data",
    "scholarly-research",
    "stdio",
    "streamable-http",
    "typescript"
  ],
  "author": "cyanheads <casey@caseyjhand.com> (https://github.com/cyanheads/openalex-mcp-server#readme)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "homepage": "https://github.com/cyanheads/openalex-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/openalex-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/openalex-mcp-server.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": ["@socketsecurity/bun-security-scanner"],
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.10.14",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "^26.0.0",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.5",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
