{
  "openalex-mcp-server": {
    "command": "npx",
    "args": ["-y", "@cyanheads/openalex-mcp-server"],
    "env": {
      "MCP_TRANSPORT_TYPE": "stdio"
    },
    "env_vars": ["OPENALEX_API_KEY", "OPENALEX_MAILTO", "OPENALEX_BASE_URL", "OPENALEX_FILTER_STRING_INPUT", "OPENALEX_CLAMP_PER_PAGE", "MCP_LOG_LEVEL"]
  }
}
